# Internal location for redis artifact X-Accel-Redirect offload (ngx_http_redis).
# The API emits X-Accel-Redirect: /_ocmo_artifacts_redis/ocmo:resolve:artifact:<sha>
# Set OCMO_RESOLVE_DOWNLOAD_XACCEL_LOCATION=/_ocmo_artifacts_redis to enable.
# REDIS_HOST and REDIS_PORT are substituted by docker/gateway/99-ocmo-redis.sh.
location ~ ^/_ocmo_artifacts_redis/(.*) {
    internal;
    set $redis_key $1;
    redis_pass ${REDIS_HOST}:${REDIS_PORT};
}

# Local API development (without Docker).
# Copy to .env and adjust values. See docs/quickstart/configuration.md for the full list.
#
# SECURITY: defaults below are for local development only. Never use them in production.

# --- Required for any real deployment ---
# DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# OCMO_MASTER_KEY=base64-encoded-32-byte-aes-key  # python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"

# --- Django ---
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_LOG_LEVEL=INFO

# --- PostgreSQL (match your local instance) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ocmoapi
POSTGRES_USER=ocmoapi-user
POSTGRES_PASSWORD=change-me

# --- OIDC (Dex dev stack defaults; point at your IdP in production) ---
OIDC_DISCOVERY_DOCUMENT_URL=http://localhost:8080/dex/.well-known/openid-configuration
OIDC_JWKS_URL=http://localhost:8080/dex/keys
OIDC_ISSUER=http://localhost:8080/dex/
OIDC_CLIENT_ID=ocmo-api
OIDC_JWT_AUDIENCES=ocmo-api,ocmo-sdk
OIDC_AUTHORIZATION_URL=http://localhost:8080/dex/auth
OIDC_TOKEN_URL=http://localhost:8080/dex/token
OIDC_SWAGGER_REDIRECT_URL=http://localhost:8080/api/docs/oauth2-redirect.html
OIDC_SCOPES=openid profile email groups
OIDC_GLOBAL_ADMIN_VALUE=admin@example.com

# --- Public URL (required behind a reverse proxy) ---
# OCMO_PUBLIC_URL=https://ocmo.example.com

# --- Redis (optional: workers, redis-backed resolve cache/artifacts) ---
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# OCMO_RESOLVE_CACHE_BACKEND=redis
# OCMO_RESOLVE_ARTIFACT_BACKEND=redis

# --- Resolve / artifacts (defaults usually fine for local dev) ---
# OCMO_RESOLVE_ARTIFACT_DIR=/tmp/ocmo/resolved
# OCMO_RESOLVE_CACHE_BACKEND=locmem

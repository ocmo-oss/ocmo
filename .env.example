# Production docker-compose.yml environment.
# Copy to .env in the repository root, fill every value, then:
#   docker compose --env-file .env up
#
# See docs/quickstart/configuration.md for descriptions and defaults.

# Docker Hub image tag (ocmooss/ocmo-api, ocmooss/ocmo-frontend, ocmooss/ocmo-gateway)
OCMO_IMAGE_TAG=0.8.19
GATEWAY_PORT=8080

# --- Django / API ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=ocmo.example.com

# --- PostgreSQL (external) ---
POSTGRES_HOST=postgres.example.com
POSTGRES_PORT=5432
POSTGRES_DB=ocmoapi
POSTGRES_USER=ocmoapi
POSTGRES_PASSWORD=change-me

# --- OIDC (your identity provider) ---
OIDC_DISCOVERY_DOCUMENT_URL=https://sso.example.com/.well-known/openid-configuration
OIDC_JWKS_URL=https://sso.example.com/oauth2/v1/keys
OIDC_ISSUER=https://sso.example.com/
OIDC_CLIENT_ID=ocmo-api
OIDC_JWT_AUDIENCES=ocmo-api,ocmo-sdk
OIDC_AUTHORIZATION_URL=https://sso.example.com/oauth2/v1/authorize
OIDC_TOKEN_URL=https://sso.example.com/oauth2/v1/token
OIDC_SWAGGER_REDIRECT_URL=https://ocmo.example.com/api/docs/oauth2-redirect.html
OIDC_SCOPES=openid profile email groups
ADMIN_EMAIL=admin@example.com

# --- OCMO secrets encryption (required when using secrets) ---
OCMO_MASTER_KEY=base64-encoded-32-byte-aes-key

# --- Public gateway URL (artifact download links) ---
OCMO_PUBLIC_URL=https://ocmo.example.com

# --- Redis (recommended for multi-worker API and RQ worker profile) ---
REDIS_HOST=redis.example.com
REDIS_PORT=6379
REDIS_DB=0
OCMO_RESOLVE_CACHE_BACKEND=redis
OCMO_RESOLVE_ARTIFACT_BACKEND=redis

# --- Gunicorn ---
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120

# --- Frontend build (empty = same origin via gateway) ---
VITE_API_BASE_URL=

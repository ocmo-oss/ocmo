# API origin baked into the production bundle. Leave empty when nginx serves UI and
# proxies /api/ on the same host (recommended for gunicorn + nginx). Production CSP
# allows connect-src 'self' https: only — do not ship a build with http://localhost.
# VITE_API_BASE_URL=
#
# Local Vite dev only (API not on same origin):
# VITE_API_BASE_URL=http://localhost:8000

# Optional SPA OAuth redirect overrides (defaults to window.location.origin paths)
# VITE_OIDC_REDIRECT_URI=http://localhost:8080/login/callback
# VITE_OIDC_SILENT_REDIRECT_URI=http://localhost:8080/auth/silent-callback
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8080/login

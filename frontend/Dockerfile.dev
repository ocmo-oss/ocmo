# Development image for the OCMO frontend (Vite dev server).
# Build context: frontend/
# Source and node_modules are provided by volume mounts in docker-compose.hmr.yml.

FROM node:20-alpine

# Pin pnpm 10.x — pnpm 11+ requires Node 22.13+ (uses node:sqlite).
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

WORKDIR /app

EXPOSE 3000
